{
  "name": "3d-maker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Procedural three.js asset studio and inventory.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && vite build --mode sdk",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "audit:full": "npm audit --audit-level=high",
    "verify": "npm run test && npm run typecheck && npm run lint && npm run build",
    "check:studio": "node scripts/check-studio.mjs",
    "capture:posters": "node scripts/posters.mjs",
    "dataset": "node scripts/dataset.mjs",
    "variations:lock": "node scripts/lock-variations.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.14.1",
    "@types/three": "^0.185.0",
    "eslint": "^10.7.0",
    "playwright-core": "^1.65.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
