{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Form Foundry starter recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "template",
    "name",
    "primary",
    "accent",
    "scale",
    "proportion",
    "detail"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "template": {
      "enum": [
        "relay-drone",
        "field-rover",
        "survey-bot",
        "cargo-pod",
        "signal-tower",
        "field-pilot",
        "bakery-shopfront",
        "stone-lighthouse",
        "timber-windmill",
        "town-clock-tower",
        "torii-shrine",
        "glass-greenhouse",
        "country-train-depot",
        "fire-watchtower",
        "canal-boathouse",
        "stone-watermill",
        "dome-observatory",
        "desert-adobe-house",
        "nordic-timber-cabin",
        "market-pavilion",
        "post-office-kiosk",
        "harbor-bell-tower",
        "cyber-ramen-kiosk",
        "orbital-airlock",
        "hydroponic-dome",
        "wizard-spire",
        "castle-gatehouse",
        "solar-power-hub",
        "cargo-gantry-crane",
        "fuel-silo-station",
        "monorail-platform",
        "fortress-drawbridge",
        "neon-arcade-booth",
        "geothermal-turbine",
        "desert-radar-bunker",
        "floating-sky-dock",
        "medieval-knight",
        "arcane-mage",
        "cyber-courier",
        "deep-sea-diver",
        "arctic-explorer",
        "artisan-chef",
        "desert-nomad",
        "rescue-firefighter",
        "space-medic",
        "samurai-warden",
        "steampunk-inventor",
        "forest-ranger",
        "mech-engineer",
        "royal-guard",
        "pirate-captain",
        "orbital-astronaut",
        "vintage-biplane",
        "steam-locomotive",
        "harbor-tugboat",
        "rescue-helicopter",
        "city-tramcar",
        "coastal-sailboat",
        "warehouse-forklift",
        "desert-hover-skiff",
        "deep-submersible",
        "parcel-delivery-van",
        "hot-air-balloon",
        "farm-tractor",
        "arctic-snowcat",
        "lunar-lander",
        "racing-hoverbike",
        "armored-railcar",
        "forest-fox",
        "barn-owl",
        "sea-turtle",
        "red-panda",
        "clockwork-crab",
        "koi-fish",
        "mountain-stag",
        "emperor-penguin",
        "coral-jellyfish",
        "pocket-dragon",
        "alpine-pine-grove",
        "sakura-blossom-tree",
        "oasis-palm-spring",
        "crystal-geode-spire",
        "stone-arch-bridge",
        "bamboo-water-shrine",
        "volcanic-basalt-vent",
        "mushroom-fairy-ring",
        "treasure-chest",
        "grandfather-clock",
        "street-vending-unit",
        "blacksmith-forge",
        "espresso-bar-cart",
        "siege-catapult",
        "retro-arcade-cabinet",
        "apothecary-cabinet",
        "lantern-signpost",
        "railway-boom-gate",
        "brass-spyglass",
        "plasma-wrench",
        "runic-lantern-staff",
        "vintage-cine-camera",
        "brass-pocket-compass",
        "acoustic-lute",
        "twin-jetpack",
        "winged-kite-shield",
        "expedition-backpack",
        "shoulder-turret-pod"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "variation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Optional registered variation ID for the chosen template (for example \"winter-frost\" or \"cargo-lifter\"). Omit or pass \"default\" for the base version."
    },
    "primary": {
      "type": "string",
      "pattern": "^#[a-fA-F0-9]{6}$",
      "description": "Main body color in sRGB."
    },
    "accent": {
      "type": "string",
      "pattern": "^#[a-fA-F0-9]{6}$",
      "description": "Secondary trim color in sRGB."
    },
    "scale": {
      "type": "number",
      "minimum": 0.65,
      "maximum": 1.5,
      "description": "Uniform size multiplier. The default is 1."
    },
    "proportion": {
      "type": "number",
      "minimum": 0.65,
      "maximum": 1.5,
      "description": "Shape multiplier applied by the selected template. The default is 1."
    },
    "detail": {
      "type": "boolean",
      "description": "Enable optional secondary geometry."
    },
    "quality": {
      "enum": [
        "standard",
        "hd"
      ],
      "default": "standard",
      "description": "Choose the authored geometry level. Older recipes use standard when this field is absent."
    }
  }
}
