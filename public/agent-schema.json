      "type": "boolean",
      "description": "Enable optional secondary geometry."
    },
    "quality": {
      "enum": [
        "standard",
        "hd"
      ],
      "default": "standard",
      "description": "Choose the authored geometry level. Older recipes use standard when this field is absent."
    },
    "params": {
      "type": "object",
      "maxProperties": 24,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        ]
      },
